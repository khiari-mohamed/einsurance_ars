<!DOCTYPE html>
<html lang="fr">
<head>
<meta charset="UTF-8"/>
<title>{{title}} — {{bordereau.numero}}</title>
<script src="https://cdn.jsdelivr.net/npm/chart.js@4.4.0/dist/chart.umd.min.js"></script>
<style>
  :root { --ars-red:#d52b36; --ars-dark:#1a1a2e; --ars-light:#f8f9fa; --border:#dee2e6; --text:#212529; --muted:#6c757d; --green:#2d6a4f; }
  *{box-sizing:border-box;margin:0;padding:0}
  body{font-family:Arial,Helvetica,sans-serif;font-size:10.5px;color:var(--text);background:#fff;line-height:1.4}
  .page-header{background:var(--ars-red);color:#fff;padding:14px 20px;display:flex;justify-content:space-between;align-items:center;border-bottom:4px solid #a51e28}
  .logo-text{font-size:20px;font-weight:700;letter-spacing:1px}
  .logo-sub{font-size:9px;opacity:.85}
  .doc-title{text-align:center;font-size:13px;font-weight:700;letter-spacing:.5px}
  .doc-ref{font-size:9px;opacity:.85;margin-top:3px;text-align:center}
  .status-strip{padding:6px;text-align:center;font-size:9px;font-weight:700;letter-spacing:2px;text-transform:uppercase;color:#fff}
  .status-brouillon{background:#6c757d}
  .status-en_validation{background:#b8860b}
  .status-valide{background:#2d6a4f}
  .status-emis{background:#1565c0}
  .status-acquitte{background:#6f42c1}
  .status-archive{background:#495057}
  .parties{display:flex;border-bottom:1px solid var(--border)}
  .party-box{flex:1;padding:12px 16px;border-right:1px solid var(--border)}
  .party-box:last-child{border-right:none}
  .party-label{font-size:8px;font-weight:700;color:var(--ars-red);text-transform:uppercase;letter-spacing:.8px;margin-bottom:4px}
  .party-name{font-size:12px;font-weight:700}
  .party-detail{font-size:9px;color:var(--muted);margin-top:2px}
  .section-header{background:var(--ars-light);border-left:4px solid var(--ars-red);padding:6px 12px;font-weight:700;font-size:10px;text-transform:uppercase;letter-spacing:.5px;color:var(--ars-dark)}
  .info-grid{display:grid;grid-template-columns:repeat(4,1fr);border-bottom:1px solid var(--border)}
  .info-cell{padding:8px 12px;border-right:1px solid var(--border);border-bottom:1px solid var(--border)}
  .info-cell:nth-child(4n){border-right:none}
  .info-cell .label{font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:2px}
  .info-cell .value{font-weight:600;font-size:10.5px}
  table{width:100%;border-collapse:collapse;font-size:9.5px}
  thead tr{background:var(--ars-red);color:#fff}
  thead th{padding:7px 8px;text-align:right;font-weight:600;font-size:8.5px;text-transform:uppercase;letter-spacing:.3px;border-right:1px solid rgba(255,255,255,.2)}
  thead th:first-child{text-align:left}
  tbody tr:nth-child(even){background:#fafafa}
  tbody td{padding:6px 8px;border-bottom:1px solid var(--border);border-right:1px solid var(--border);text-align:right}
  tbody td:first-child{text-align:left;font-weight:500}
  tfoot tr{background:var(--ars-dark);color:#fff}
  tfoot td{padding:8px;font-weight:700;text-align:right;font-size:10px}
  tfoot td:first-child{text-align:left}
  .totals-bar{display:flex;border-top:2px solid var(--ars-red);border-bottom:2px solid var(--ars-red)}
  .total-cell{flex:1;padding:10px 14px;border-right:1px solid var(--border);text-align:center}
  .total-cell:last-child{border-right:none}
  .t-label{font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px}
  .t-value{font-size:13px;font-weight:700;color:var(--ars-red);margin-top:3px}
  .t-currency{font-size:8px;color:var(--muted)}
  .amount-words{background:#fff8f8;border:1px solid #fcc;border-left:4px solid var(--ars-red);padding:10px 14px;margin:10px 0}
  .aw-label{font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:3px}
  .aw-value{font-size:11px;font-weight:700;color:var(--ars-dark);text-transform:uppercase}
  .chart-section{padding:12px 16px;border-top:1px solid var(--border)}
  .chart-title{font-size:9px;font-weight:700;color:var(--ars-red);text-transform:uppercase;letter-spacing:.5px;margin-bottom:8px}
  .signatures{display:flex;border-top:1px solid var(--border);margin-top:16px}
  .sig-block{flex:1;padding:14px 16px;border-right:1px solid var(--border);text-align:center}
  .sig-block:last-child{border-right:none}
  .sig-label{font-size:8px;color:var(--muted);text-transform:uppercase;letter-spacing:.5px;margin-bottom:40px}
  .sig-line{border-top:1px solid var(--border);padding-top:5px;font-size:8px;color:var(--muted)}
  .doc-footer{background:var(--ars-dark);color:rgba(255,255,255,.7);text-align:center;font-size:8px;padding:8px}
  .notes-box{padding:10px 16px;font-size:9.5px;color:var(--muted);border-top:1px dashed var(--border)}
  @media print{body{-webkit-print-color-adjust:exact;print-color-adjust:exact}}
</style>
</head>
<body>

<div class="page-header">
  <div><div class="logo-text">ARS</div><div class="logo-sub">Réassurance Tunisie</div></div>
  <div>
    <div class="doc-title">{{upper title}}</div>
    <div class="doc-ref">N° {{bordereau.numero}} — Émis le {{generatedAt}}</div>
  </div>
  <div style="text-align:right;font-size:9px">
    <div style="opacity:.9">{{company.raisonSociale}}</div>
    <div style="opacity:.7">MF: {{company.matriculeFiscal}}</div>
  </div>
</div>

<div class="status-strip status-{{lower bordereau.statut}}">
  Statut: {{bordereau.statut}}
  {{#if bordereau.dateValidation}} — Validé le {{formatDate bordereau.dateValidation}}{{/if}}
  {{#if bordereau.dateEnvoi}} — Envoyé le {{formatDate bordereau.dateEnvoi}}{{/if}}
</div>

<div class="parties">
  <div class="party-box">
    <div class="party-label">Courtier / Réassureur</div>
    <div class="party-name">{{company.raisonSociale}}</div>
    <div class="party-detail">{{company.adresse}}</div>
    <div class="party-detail">MF: {{company.matriculeFiscal}}</div>
  </div>

  {{#if (eq bordereau.type "CESSION_CEDANTE")}}
  <div class="party-box">
    <div class="party-label">Cédante</div>
    <div class="party-name">{{default bordereau.cedante.raisonSociale '—'}}</div>
    <div class="party-detail">Code: {{default bordereau.cedante.code '—'}}</div>
    <div class="party-detail">Compte: {{default bordereau.cedante.compteComptable '—'}}</div>
  </div>
  {{else}}
  <div class="party-box">
    <div class="party-label">Réassureur</div>
    <div class="party-name">{{default bordereau.reassureur.raisonSociale bordereau.reassureurCode}}</div>
    <div class="party-detail">Code: {{default bordereau.reassureurCode '—'}}</div>
    <div class="party-detail">Compte: {{default bordereau.reassureur.compteComptable '—'}}</div>
  </div>
  {{/if}}

  <div class="party-box">
    <div class="party-label">Affaire liée</div>
    <div class="party-name">{{default bordereau.affaire.numero '—'}}</div>
    {{#if bordereau.affaire.type}}<div class="party-detail">Type: {{bordereau.affaire.type}}</div>{{/if}}
  </div>
</div>

<div class="section-header">Informations Générales</div>
<div class="info-grid">
  <div class="info-cell">
    <div class="label">Période Début</div>
    <div class="value">{{formatDate bordereau.datePeriodeDebut}}</div>
  </div>
  <div class="info-cell">
    <div class="label">Période Fin</div>
    <div class="value">{{formatDate bordereau.datePeriodeFin}}</div>
  </div>
  <div class="info-cell">
    <div class="label">Date Limite Paiement</div>
    <div class="value" style="{{#if bordereau.isOverdue}}color:var(--ars-red){{/if}}">{{formatDate bordereau.dateLimitePaiement}}</div>
  </div>
  <div class="info-cell">
    <div class="label">Devise</div>
    <div class="value">{{bordereau.currency}}</div>
  </div>
</div>

<div class="section-header" style="margin-top:6px">Détail des Lignes</div>
<table>
  <thead>
    <tr>
      <th style="text-align:left">Libellé</th>
      <th>Prime 100%</th>
      <th>Taux Cession</th>
      <th>Prime Brute</th>
      <th>Comm. Cédante</th>
      <th>Comm. Courtage</th>
      <th>Prime Nette</th>
    </tr>
  </thead>
  <tbody>
    {{#each bordereau.lines}}
    <tr>
      <td>{{libelle}}{{#if couverture}} — {{couverture}}{{/if}}</td>
      <td>{{formatNumber prime100}}</td>
      <td>{{#if tauxCession}}{{formatPercent tauxCession}}{{else}}—{{/if}}</td>
      <td>{{formatNumber primeBrute}}</td>
      <td>{{formatNumber commissionCedante}}</td>
      <td>{{formatNumber commissionCourtage}}</td>
      <td style="color:var(--green);font-weight:700">{{formatNumber primeNette}}</td>
    </tr>
    {{else}}
    <tr><td colspan="7" style="text-align:center;color:var(--muted)">Aucune ligne</td></tr>
    {{/each}}
  </tbody>
  <tfoot>
    <tr>
      <td>TOTAUX</td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td></td>
      <td>{{formatNumber bordereau.montantTotal}}</td>
    </tr>
  </tfoot>
</table>

<div class="totals-bar">
  <div class="total-cell">
    <div class="t-label">Montant Total</div>
    <div class="t-value">{{formatNumber bordereau.montantTotal}}</div>
    <div class="t-currency">{{bordereau.currency}}</div>
  </div>
  <div class="total-cell">
    <div class="t-label">Réglé</div>
    <div class="t-value" style="color:var(--green)">{{formatNumber bordereau.montantRegle}}</div>
    <div class="t-currency">{{bordereau.currency}}</div>
  </div>
  <div class="total-cell">
    <div class="t-label">Solde</div>
    <div class="t-value">{{formatNumber bordereau.solde}}</div>
    <div class="t-currency">{{bordereau.currency}}</div>
  </div>
</div>

{{#if bordereau.montantEnLettres}}
<div class="amount-words">
  <div class="aw-label">Montant en lettres</div>
  <div class="aw-value">{{bordereau.montantEnLettres}}</div>
</div>
{{/if}}

{{#if (gt (length bordereau.lines) 1)}}
<div class="chart-section">
  <div class="chart-title">Répartition par Ligne</div>
  <canvas id="linesChart" height="90"></canvas>
</div>
{{/if}}

{{#if bordereau.notes}}
<div class="notes-box"><strong>Notes:</strong> {{bordereau.notes}}</div>
{{/if}}

<div class="signatures">
  <div class="sig-block">
    <div class="sig-label">{{#if (eq bordereau.type "CESSION_CEDANTE")}}Pour la Cédante{{else}}Pour le Réassureur{{/if}}</div>
    <div class="sig-line">Signature et cachet</div>
  </div>
  <div class="sig-block">
    <div class="sig-label">Pour {{company.raisonSociale}}</div>
    <div class="sig-line">Signature et cachet</div>
  </div>
  <div class="sig-block">
    <div class="sig-label">Date d'émission</div>
    <div class="sig-line">{{generatedAt}}</div>
  </div>
</div>

<div class="doc-footer">
  {{company.raisonSociale}} — {{company.adresse}} — Document confidentiel — {{bordereau.numero}}
</div>

<script>
(function() {
  var lines = {{{json bordereau.lines}}} || [];
  var labels = lines.map(function(l) { return l.libelle || '—'; });
  var values = lines.map(function(l) { return Number(l.primeNette || l.primeBrute || 0); });

  var ctx = document.getElementById('linesChart');
  if (ctx && lines.length > 1) {
    new Chart(ctx, {
      type: 'bar',
      data: { labels: labels, datasets: [{ label: '{{bordereau.currency}}', data: values, backgroundColor: '#d52b36', borderRadius: 3 }] },
      options: {
        responsive: true,
        plugins: { legend: { display: false } },
        scales: { y: { beginAtZero: true, ticks: { font: { size: 9 } } }, x: { ticks: { font: { size: 8 } }, grid: { display: false } } }
      }
    });
  }
  window.__chartsReady = true;
  window.dispatchEvent(new Event('chartsReady'));
})();
</script>
</body>
</html>